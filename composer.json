{
    "name": "cline/laravel-redis-sentinel",
    "description": "Redis Sentinel driver for Laravel's PhpRedis integration",
    "keywords": [
        "laravel",
        "redis",
        "sentinel",
        "phpredis"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Brian Faust",
            "email": "brian@cline.sh"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-redis": "*",
        "illuminate/contracts": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/redis": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0"
    },
    "scripts": {
        "test": [
            "@test:cs",
            "@test:unit"
        ],
        "test:cs": "vendor/bin/pint -v",
        "test:unit": "vendor/bin/phpunit --testdox --log-junit=phpunit.report-junit.xml --coverage-clover=phpunit.coverage-clover.xml --coverage-text",
        "fix:cs": "vendor/bin/pint -v"
    },
    "autoload": {
        "psr-4": {
            "Cline\\RedisSentinel\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cline\\RedisSentinel\\RedisSentinelServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
